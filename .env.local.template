# Ticklab - Environment Variables
# All data sources are FREE - no API keys required for basic functionality

# ============================================
# OPTIONAL: Custom RPC Endpoints
# If not set, the app will use free public RPCs
# ============================================

# Ethereum Mainnet (optional - uses public RPCs if not set)
# ETHEREUM_RPC_URL="https://eth.llamarpc.com"

# Arbitrum (optional - uses public RPCs if not set)
# ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"

# Base (optional - uses public RPCs if not set)
# BASE_RPC_URL="https://mainnet.base.org"

# Optimism (optional - uses public RPCs if not set)
# OPTIMISM_RPC_URL="https://mainnet.optimism.io"

# Polygon (optional - uses public RPCs if not set)
# POLYGON_RPC_URL="https://polygon-rpc.com"

# ============================================
# OPTIONAL: WalletConnect Project ID
# Required for wallet connection
# Get one free at: https://cloud.walletconnect.com
# ============================================
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=""

# ============================================
# OPTIONAL: Database (for saving strategies)
# If not set, strategies will only be saved locally
# ============================================
# DATABASE_URL="postgresql://user:password@localhost:5432/ticklab"

# ============================================
# NOTE: This app uses FREE data sources:
# - DeFi Llama API (pool TVL/volume) - no key needed
# - Public RPC endpoints (on-chain data) - no key needed
# - Hardcoded top pools per chain - no API needed
# ============================================
