# =============================================================================
# UniV3 Strategy Lab — Environment Variables
# =============================================================================
# Copy to `.env.local` for development, set in your hosting provider for
# production. Never commit secrets.
# =============================================================================

# --- Public RPCs (used as fallbacks) -----------------------------------------
# Comma-separated per-chain. The app will use the first one that responds.
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth.llamarpc.com
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_OPTIMISM_RPC_URL=https://mainnet.optimism.io
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# --- Wagmi / WalletConnect --------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- API keys for higher-rate data sources ----------------------------------
# Optional but recommended for production. Free tiers are sufficient for
# research use; sign up at:
#   - https://etherscan.io/apis            (Etherscan, ~100k req/day free)
#   - https://www.alchemy.com/             (Alchemy, ~300M CU/month free)
#   - https://www.infura.io/               (Infura, ~100k req/day free)
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
INFURA_KEY=

# --- DefiLlama (no key required, included for reference) -------------------
# https://api.llama.fi — used for TVL/APR enrichment, no auth needed.

# --- Logging / observability (production only) ------------------------------
# Sentry DSN — wire your APM here. The codebase already logs to console with
# `[api]` prefix; replace with a real transport in production.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Feature flags ----------------------------------------------------------
# Disable specific data sources without rebuilding.
NEXT_PUBLIC_DISABLE_DEFILLAMA=false
NEXT_PUBLIC_DISABLE_LIVE_RPC=false