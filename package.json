    "@radix-ui/react-slot": "^1.0.2",
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@tanstack/react-query": "^5.32.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wagmi/core": "^2.13.0",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.0",
